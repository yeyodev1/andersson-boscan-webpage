VITE_API_BASE_URL=http://localhost:8100/api

# GoHighLevel Webhooks
VITE_GHL_WEBHOOK_CONTACT=https://services.leadconnectorhq.com/hooks/FJiKT3Tu4PoiQ7G3slal/webhook-trigger/0c36bf5b-08ec-4d92-8fdd-49e1944de4c5
VITE_GHL_WEBHOOK_OPPORTUNITY=https://services.leadconnectorhq.com/hooks/PENDIENTE/webhook-trigger/PENDIENTE

# Acceso directo al panel /integraciones: SHA-256 de "correo:contraseña".
# Definirlo también en las variables de entorno del hosting.
# Generarlo: printf '%s' 'correo:contraseña' | shasum -a 256
VITE_ACCESO_DIRECTO_HASH=

# App de TikTok — client key (PÚBLICA: va en la URL de autorización)
VITE_TIKTOK_CLIENT_KEY=

# ───────────────────────────────────────────────────────────────────
# Backend de TikTok (api/tiktok/*). Estas van SOLO en las variables de
# entorno de Vercel, NUNCA en el repo (es público). No llevan prefijo VITE_.
#   TIKTOK_CLIENT_KEY     = misma client key de la app de TikTok
#   TIKTOK_CLIENT_SECRET  = client secret de la app (antes estaba expuesto en el frontend)
#   TIKTOK_API_SECRET     = secreto que inventás tú; la automatización lo manda
#                           como  Authorization: Bearer <TIKTOK_API_SECRET>
#   MONGODB_URI           = cadena de conexión del cluster (guarda los tokens)
# ───────────────────────────────────────────────────────────────────