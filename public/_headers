/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN

# Assets del build de Vite (nombre con hash): caché larga e inmutable
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Assets de la entrega de periodismo: caché larga (requisito del documento
# de entrega: caché larga solo para assets/)
/periodismo/assets/*
  Cache-Control: public, max-age=31536000
